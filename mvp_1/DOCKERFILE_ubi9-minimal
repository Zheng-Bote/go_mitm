# Build stage or just base image
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Metadata
LABEL maintainer="ZHENG Robert (robert@hase-zheng.net)"
LABEL description="Cority Uploader MVP_1 on UBI 9 Minimal"

# Install Python and dependencies
RUN microdnf install -y python3 python3-pip shadow-utils && \
    microdnf clean all

# Create a non-root user
RUN groupadd -r uploader && useradd -r -g uploader uploader

# Set working directory
WORKDIR /app

# Copy application files
COPY uploader.py .
COPY data.json .
# Note: .env and token.json should ideally be mounted or passed via env vars, 
# but copying for completeness if they exist in build context.
COPY .env .

# Install python requests if not available via system packages
# UBI 9 minimal might need pip for requests
RUN pip-3 install requests

# Set permissions
RUN chown -R uploader:uploader /app

# Switch to non-root user
USER uploader

# Expose port 8080 for the internal HTTP server
EXPOSE 8080

# Environment variables (can be overridden at runtime)
# The script uses os.environ.get() so these will be picked up

# Start the script
CMD ["python3", "uploader.py"]
